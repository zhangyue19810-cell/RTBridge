#version 460
#extension GL_EXT_ray_tracing : require

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba16f) uniform image2D giImage;
layout(binding = 2, set = 0) uniform sampler2D gDepth;
layout(binding = 3, set = 0) uniform sampler2D gNormal;

layout(binding = 4, set = 0) uniform CameraUBO {
    mat4 invView;
    mat4 invProj;
    vec4 lightDir;
} cam;

layout(location = 0) rayPayloadEXT vec3 irradiance;

// ── Simple RNG (pcg hash) ─────────────────────────────────────────────────────
uint pcg(uint v) {
    uint s = v * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}
float rand(inout uint seed) {
    seed = pcg(seed);
    return float(seed) / float(0xFFFFFFFFu);
}

// ── Cosine hemisphere sample ──────────────────────────────────────────────────
vec3 cosineSampleHemisphere(vec3 N, inout uint seed) {
    float u1 = rand(seed), u2 = rand(seed);
    float r   = sqrt(u1);
    float phi = 6.28318 * u2;
    vec3  L   = vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u1)));

    // Build tangent frame
    vec3 up  = abs(N.y) < 0.999 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 T   = normalize(cross(up, N));
    vec3 B   = cross(N, T);
    return normalize(T * L.x + B * L.y + N * L.z);
}

void main() {
    const vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5) / vec2(gl_LaunchSizeEXT.xy);

    float depth = texture(gDepth, uv).r;
    if (depth >= 1.0) {
        imageStore(giImage, ivec2(gl_LaunchIDEXT.xy), vec4(0.0));
        return;
    }

    vec4 ndc     = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 viewPos = cam.invProj * ndc;
    viewPos     /= viewPos.w;
    vec3 worldPos = (cam.invView * viewPos).xyz;
    vec3 N = normalize(texture(gNormal, uv).xyz * 2.0 - 1.0);

    // Per-pixel seed from position + frame counter
    uint seed = pcg(gl_LaunchIDEXT.x + gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x);

    // One bounce GI: shoot cosine-weighted hemisphere ray
    vec3 giDir = cosineSampleHemisphere(N, seed);

    irradiance = vec3(0.0);
    traceRayEXT(topLevelAS,
        gl_RayFlagsOpaqueEXT,
        0xFF, 0, 0, 0,
        worldPos + N * 0.005,
        0.001,
        giDir,
        100.0,  // short range for GI
        0);

    // irradiance is filled by closest-hit
    imageStore(giImage, ivec2(gl_LaunchIDEXT.xy), vec4(irradiance, 1.0));
}
