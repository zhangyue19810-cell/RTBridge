#version 460
#extension GL_EXT_ray_tracing : require

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba16f) uniform image2D giImage;
layout(binding = 2, set = 0) uniform sampler2D gDepth;
layout(binding = 3, set = 0) uniform sampler2D gNormal;
layout(binding = 4, set = 0) uniform CameraUBO {
    mat4 invView; mat4 invProj;
    vec4 lightDir; vec4 cameraPos;
    float time; float nearPlane; float farPlane; float pad;
} cam;
layout(binding = 5, set = 0) uniform sampler2D gMaterial;
layout(binding = 6, set = 0) uniform sampler2D gAlbedo;

layout(location = 0) rayPayloadEXT vec4 giPayload; // rgb=irradiance, a=hitDist

const float PI = 3.14159265;

// PCG hash
uint pcg(uint v) {
    uint s = v * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}
float rand(inout uint seed) {
    seed = pcg(seed);
    return float(seed) * (1.0 / 4294967295.0);
}

// 余弦半球采样
vec3 cosineSampleHemisphere(vec3 N, inout uint seed) {
    float u1  = rand(seed), u2 = rand(seed);
    float r   = sqrt(u1);
    float phi = 2.0 * PI * u2;
    vec3  L   = vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u1)));
    vec3 up   = abs(N.y) < 0.999 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 T    = normalize(cross(up, N));
    vec3 B    = cross(N, T);
    return normalize(T * L.x + B * L.y + N * L.z);
}

vec3 reconstructWorldPos(vec2 uv, float depth) {
    vec4 ndc     = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 viewPos = cam.invProj * ndc;
    viewPos     /= viewPos.w;
    return (cam.invView * viewPos).xyz;
}

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    vec2  uv    = (vec2(pixel) + 0.5) / vec2(gl_LaunchSizeEXT.xy);

    float depth = texture(gDepth,  uv).r;
    if (depth >= 0.9999) {
        imageStore(giImage, pixel, vec4(0.0));
        return;
    }

    vec3 worldPos = reconstructWorldPos(uv, depth);
    vec3 N        = normalize(texture(gNormal, uv).rgb * 2.0 - 1.0);
    vec3 albedo   = texture(gAlbedo, uv).rgb;

    uint seed = pcg(uint(pixel.x)
                  + uint(pixel.y) * uint(gl_LaunchSizeEXT.x)
                  + uint(cam.time * 1000.0) * 17u);

    // ── 多重重要性采样 GI（2 SPP，每帧不同方向，时域积累）────────────────
    const int SPP = 2;
    vec3 totalIrradiance = vec3(0.0);

    for (int i = 0; i < SPP; i++) {
        vec3 giDir = cosineSampleHemisphere(N, seed);

        giPayload = vec4(0.0, 0.0, 0.0, -1.0);
        traceRayEXT(topLevelAS,
            gl_RayFlagsOpaqueEXT,
            0xFF, 0, 0, 0,
            worldPos + N * 0.01,
            0.001,
            giDir,
            80.0,  // GI 射线最远 80 块
            0);

        vec3 irradiance = giPayload.rgb;

        // 彩色光传播：命中点的辐射与发射方向的 albedo 相乘
        // （模拟光在表面之间反弹时的颜色混合）
        totalIrradiance += irradiance * albedo;
    }

    totalIrradiance /= float(SPP);

    // 能量守恒：除以 pi（Lambert BRDF）
    totalIrradiance *= (1.0 / PI);

    imageStore(giImage, pixel, vec4(totalIrradiance, 1.0));
}
