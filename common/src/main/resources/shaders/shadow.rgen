#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference2 : require

// ── Output ────────────────────────────────────────────────────────────────────
layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, r8) uniform image2D shadowImage;

// ── GBuffer inputs ────────────────────────────────────────────────────────────
layout(binding = 2, set = 0) uniform sampler2D gDepth;
layout(binding = 3, set = 0) uniform sampler2D gNormal;

// ── Camera UBO ────────────────────────────────────────────────────────────────
layout(binding = 4, set = 0) uniform CameraUBO {
    mat4 invView;
    mat4 invProj;
    vec4 lightDir;   // xyz = sun direction (normalised), w = intensity
} cam;

// ── Payload ───────────────────────────────────────────────────────────────────
layout(location = 0) rayPayloadEXT float shadowed; // 1.0 = in shadow, 0.0 = lit

void main() {
    const vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    const vec2 uv = pixelCenter / vec2(gl_LaunchSizeEXT.xy);

    // Reconstruct world position from depth
    float depth = texture(gDepth, uv).r;
    if (depth >= 1.0) {
        imageStore(shadowImage, ivec2(gl_LaunchIDEXT.xy), vec4(1.0));
        return;
    }

    vec4 ndcPos   = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 viewPos  = cam.invProj * ndcPos;
    viewPos      /= viewPos.w;
    vec4 worldPos = cam.invView * viewPos;

    vec3 normal   = normalize(texture(gNormal, uv).xyz * 2.0 - 1.0);
    vec3 lightVec = normalize(-cam.lightDir.xyz);

    // Bias to avoid self-intersection
    vec3 origin = worldPos.xyz + normal * 0.005;

    // N·L cull: if surface faces away from light, it's in shadow
    if (dot(normal, lightVec) <= 0.0) {
        imageStore(shadowImage, ivec2(gl_LaunchIDEXT.xy), vec4(0.0));
        return;
    }

    shadowed = 0.0;
    traceRayEXT(
        topLevelAS,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        0xFF,          // cullMask
        0,             // sbtRecordOffset
        0,             // sbtRecordStride
        0,             // missIndex
        origin,        // ray origin
        0.001,         // tMin
        lightVec,      // ray direction
        10000.0,       // tMax  (sun = parallel light, far away)
        0              // payload location
    );

    // shadowed is set to 1.0 by any-hit if something was hit
    imageStore(shadowImage, ivec2(gl_LaunchIDEXT.xy), vec4(1.0 - shadowed));
}
